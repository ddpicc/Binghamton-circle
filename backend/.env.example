# Binghamton Circle Backend
# 当前后端运行在微信云托管上，这里保留云托管场景下实际需要的核心环境变量示例。

# 运行环境
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-frontend-domain.com

# MySQL（云托管/CloudBase 环境变量）
# 云托管通常直接注入以下变量，代码会优先读取 MYSQL_*。
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=binghamton_circle
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# JWT
JWT_SECRET=change-this-access-secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# 微信小程序 / 云托管开放接口服务
# 需在云托管控制台开启“开放接口服务”，并把 /wxa/msg_sec_check 加入权限配置。
WECHAT_CONTENT_SECURITY_ENABLED=true

# 邮件
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# 业务配置
SCHOOL_EMAIL_DOMAINS=binghamton.edu,broomecc.edu,suny.edu
NON_EDU_VERIFICATION_BASE_URL=https://your-frontend-domain.com
NON_EDU_TOKEN_EXPIRATION_HOURS=24

# 可选
# MAX_FILE_SIZE=10485760

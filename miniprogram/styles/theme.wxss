.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 20rpx 45rpx rgba(15, 23, 42, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2933;
}

.loading,
.empty {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.primary-button {
  background: #006633;
  color: #ffffff;
  border-radius: 18rpx;
}

.secondary-button {
  background: rgba(0, 102, 51, 0.12);
  color: #006633;
  border-radius: 18rpx;
}

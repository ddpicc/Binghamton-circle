.nav-header {
  width: 100%;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
  color: #ffffff;
}

.status-bar {
  width: 100%;
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left,
.nav-right {
  width: 120rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  background: transparent;
  color: #ffffff;
  font-size: 32rpx;
  padding: 0;
  border: none;
}

.back-icon {
  font-size: 40rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

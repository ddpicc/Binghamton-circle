.sheet-host {
  position: fixed;
  inset: 0;
  z-index: 9999;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(10, 26, 16, 0.46);
}

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 36rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: linear-gradient(180deg, #d7e6dc 0%, #cfe1d6 100%);
  box-shadow: 0 -12rpx 28rpx rgba(15, 95, 52, 0.16);
}

.sheet-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #184f31;
}

.sheet-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #4c6254;
}

.avatar-picker {
  margin-top: 22rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 20rpx;
  border: none;
  background: #f6f8f7;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.avatar-picker::after {
  border: none;
}

.picker-avatar-img,
.picker-avatar-fallback {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.picker-avatar-fallback {
  background: #0f7b3f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-tip {
  margin-left: 14rpx;
  color: #45584b;
  font-size: 26rpx;
}

.nickname-input {
  margin-top: 18rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f3f4f4;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #233b2c;
}

.submit-btn {
  margin-top: 18rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 18rpx;
  border: none;
  background: #0f7238;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.submit-btn::after {
  border: none;
}

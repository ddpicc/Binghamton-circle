.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(117, 159, 126, 0.16), transparent 36%),
    linear-gradient(180deg, #fafaf5 0%, #f4f5ee 100%);
  color: #1a1c19;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 40;
  background: rgba(250, 250, 245, 0.84);
  backdrop-filter: blur(16rpx);
}

.top-inner {
  height: 64px;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.left-wrap {
  display: flex;
  align-items: center;
}

.skip-btn {
  font-size: 24rpx;
  color: #5e6c60;
}

.scroll {
  height: 100vh;
}

.container {
  padding: 0 40rpx calc(env(safe-area-inset-bottom) + 160rpx);
}

.eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  color: #5e6c60;
  margin-bottom: 18rpx;
}

.title {
  font-size: 54rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #173120;
}

.desc {
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f695f;
}

.card {
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 28rpx;
  box-shadow: 0 20rpx 48rpx rgba(22, 45, 28, 0.06);
}

.label {
  display: block;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2f21;
}

.avatar-btn {
  width: 100%;
  padding: 0;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview,
.avatar-placeholder {
  width: 180rpx;
  height: 180rpx;
  border-radius: 90rpx;
}

.avatar-preview {
  display: block;
}

.avatar-placeholder {
  background: linear-gradient(180deg, #eef4ec 0%, #e1eadf 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.avatar-icon {
  width: 52rpx;
  height: 52rpx;
}

.avatar-tip {
  font-size: 22rpx;
  color: #5f695f;
}

.nickname-input {
  width: 100%;
  min-height: 92rpx;
  border-radius: 20rpx;
  background: #f4f6ef;
  font-size: 26rpx;
  color: #1a1c19;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(250, 250, 245, 0.92);
  backdrop-filter: blur(18rpx);
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  background: #004b24;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-btn::after {
  border: none;
}

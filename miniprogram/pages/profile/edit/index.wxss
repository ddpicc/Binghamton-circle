.page {
  min-height: 100vh;
  background: #fafaf5;
  color: #1a1c19;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 40;
  background: rgba(250, 250, 245, 0.84);
  backdrop-filter: blur(16rpx);
}

.top-inner {
  height: 64px;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
}

.left-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: #3f4940;
}

.scroll {
  height: 100vh;
}

.container {
  padding-right: 40rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 170rpx);
  padding-left: 40rpx;
  }

.section-label {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #6f7a6f;
  opacity: 0.7;
  margin: 20rpx 4rpx 12rpx;
}

.section-gap {
  margin-top: 34rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.row {
  min-height: 98rpx;
  border-radius: 20rpx;
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-title {
  font-size: 28rpx;
  color: #1a1c19;
  font-weight: 600;
}

.row-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.row-value {
  font-size: 22rpx;
  color: #6f7a6f;
}

.action-text {
  font-size: 22rpx;
  color: #006633;
  font-weight: 600;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar,
.avatar-fallback {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}

.avatar-fallback {
  background: #dadad5;
  color: #6f7a6f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.chevron {
  width: 28rpx;
  height: 28rpx;
}

.bio-card {
  border-radius: 20rpx;
  background: #ffffff;
  padding: 24rpx;
}

.bio-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.edit-tag {
  font-size: 22rpx;
  color: #6f7a6f;
}

.bio-text {
  font-size: 24rpx;
  color: #3f4940;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(250, 250, 245, 0.9);
  backdrop-filter: blur(18rpx);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  background: #004b24;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.save-btn::after {
  border: none;
}

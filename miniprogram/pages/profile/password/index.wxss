.page { min-height: 100vh; background: #fafaf5; }
.scroll { height: 100vh; }
.container { padding: 124rpx 28rpx 48rpx; }
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(26, 28, 25, 0.05);
}
.tip {
  font-size: 24rpx;
  color: #6f7a6f;
  line-height: 1.6;
  margin-bottom: 18rpx;
}
.input {
  height: 84rpx;
  background: #f7f8f5;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  color: #1a1c19;
  margin-bottom: 14rpx;
}
.save-btn {
  margin-top: 8rpx;
  border-radius: 18rpx;
  background: #0f5f34;
  color: #fff;
}

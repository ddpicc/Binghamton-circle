<view class="page">
  <view class="topbar" style="padding-top: {{safeTop + 24}}px;">
    <view class="topbar-inner">
      <view class="back-btn" bindtap="handleBack">
        <image class="back-icon" src="/assets/icons/arrow_back_ios_new_24dp_E3E3E3_FILL1_wght400_GRAD0_opsz24.svg" mode="aspectFit" />
      </view>
      <view class="title-wrap">
        <text class="title">我的收藏</text>
        <text class="subtitle">共 {{total}} 条记录</text>
      </view>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y enable-back-to-top>
    <view class="content" style="padding-top: {{safeTop + 96}}px;">
      <view wx:if="{{loading && !items.length}}" class="placeholder">正在加载你的收藏...</view>
      <view wx:elif="{{!items.length}}" class="placeholder">你还没有收藏任何内容</view>

      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card"
        data-route="{{item.route}}"
        bindtap="handleItemTap"
      >
        <view class="card-top">
          <text class="badge {{item.badgeClass}}">{{item.typeLabel}}</text>
          <text class="time">{{item.likedText}} 收藏</text>
        </view>
        <text class="card-title">{{item.title}}</text>
        <text class="card-summary">{{item.summaryText}}</text>
        <view class="card-bottom">
          <text class="card-meta">点击查看详情</text>
          <image class="arrow" src="/assets/icons/chevron-right-filled.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="safe-bottom"></view>
    </view>
  </scroll-view>
</view>

.page {
  min-height: 100vh;
  background: #fafaf5;
  color: #1a1c19;
}

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(250, 250, 245, 0.84);
  backdrop-filter: blur(18rpx);
}

.top-inner {
  height: 72rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mini-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e8e8e3;
  color: #6f7a6f;
}

.mini-avatar image,
.mini-avatar-fallback {
  width: 100%;
  height: 100%;
}

.mini-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-avatar-icon {
  width: 34rpx;
  height: 34rpx;
}

.topbar-title {
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #004b24;
}

.scroll {
  height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}

.loading {
  padding: 220rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #6f7a6f;
}

.empty-auth {
  margin: 0 32rpx 0;
  padding: 6rpx 8rpx 24rpx;
  text-align: center;
}

.welcome-cover {
  width: 100%;
  height: 392rpx;
  border-radius: 30rpx;
  display: block;
  box-shadow: 0 10rpx 28rpx rgba(15, 26, 17, 0.1);
}

.welcome-title {
  margin-top: 30rpx;
  color: #116335;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.25;
}

.welcome-desc {
  margin: 20rpx auto 0;
  max-width: 640rpx;
  color: #2f3d33;
  font-size: 31rpx;
  line-height: 1.7;
}

.desc-highlight {
  color: #0f6a38;
  font-weight: 700;
}

.login-actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.login-btn {
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 999rpx;
  font-size: 37rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.login-btn::after {
  border: none;
}

.wechat-login-btn {
  background: #0b6a37;
  color: #fff;
}

.email-login-btn {
  background: #f1f3ef;
  color: #0f5f34;
}

.btn-icon {
  font-size: 34rpx;
  line-height: 1;
}

.agreement-row {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 10rpx;
  text-align: left;
}

.agreement-box {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  border: 2rpx solid #c7cec4;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.agreement-box.checked {
  background: #0b6a37;
  border-color: #0b6a37;
}

.agreement-check {
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
}

.agreement-text-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  max-width: 560rpx;
}

.agreement-text {
  color: #5e695f;
  font-size: 23rpx;
}

.agreement-link {
  color: #0f6a38;
  font-weight: 600;
  font-size: 23rpx;
}

.hero {
  position: relative;
  padding: 28rpx 32rpx 104rpx;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 432rpx;
  border-radius: 0 0 48rpx 48rpx;
  background: linear-gradient(135deg, #004b24, #006633);
  z-index: 0;
}

.hero-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.avatar-wrap {
  margin-top: 6rpx;
}

.avatar-shell {
  padding: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.avatar-ring {
  width: 174rpx;
  height: 174rpx;
  border-radius: 87rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.32);
  overflow: hidden;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 87rpx;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dadad5;
}

.avatar-default-icon {
  width: 104rpx;
  height: 104rpx;
}

.name {
  margin-top: 20rpx;
  font-size: 50rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #fff;
}

.bio {
  margin-top: 12rpx;
  max-width: 548rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.86);
}

.edit-btn {
  margin-top: 24rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
}

.stats-card {
  margin: -48rpx 32rpx 0;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 -8rpx 24rpx rgba(26, 28, 25, 0.06);
  display: flex;
  padding: 20rpx 0;
}

.stats-card-flat {
  margin-top: 24rpx;
}

.stat-item {
  flex: 1;
  border-right: 1rpx solid rgba(191, 201, 189, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item.no-border {
  border-right: none;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #004b24;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #3f4940;
}

.edit-btn::after,
.save-btn::after,
.empty-btn::after,
.login-btn::after {
  border: none;
}

.menu-section {
  margin: 28rpx 32rpx 0;
}

.menu-title {
  padding: 0 8rpx;
  font-size: 20rpx;
  color: #3f4940;
  letter-spacing: 2.4rpx;
  font-weight: 700;
}

.menu-group {
  margin-top: 10rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 8rpx;
}

.menu-item {
  height: 94rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #eeeee9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon {
  width: 32rpx;
  height: 32rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #1a1c19;
  font-weight: 700;
}

.menu-arrow {
  width: 30rpx;
  height: 30rpx;
}

.verify-texts {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.verify-tip {
  font-size: 18rpx;
  letter-spacing: 1.2rpx;
  color: #006633;
  font-weight: 700;
}

.editor-card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.05);
}

.editor-title {
  font-size: 30rpx;
  color: #1a1c19;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.label {
  font-size: 24rpx;
  color: #1f2933;
  font-weight: 600;
}

input,
textarea {
  width: 100%;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  border: none;
}

textarea {
  min-height: 150rpx;
}

.save-btn {
  margin-top: 8rpx;
  background: #006633;
  color: #fff;
  border-radius: 16rpx;
  font-weight: 700;
}

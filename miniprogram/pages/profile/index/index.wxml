<view class="page">
  <view class="topbar" style="padding-top: {{safeTop + 28}}px;">
    <view class="top-inner">
      <view class="topbar-left">
        <view class="mini-avatar">
          <image wx:if="{{displayAvatar}}" src="{{displayAvatar}}" mode="aspectFill" />
          <view wx:else class="mini-avatar-fallback">
            <image class="mini-avatar-icon" src="/assets/icons/person-default-muted.svg" mode="aspectFit" />
          </view>
        </view>
        <text class="topbar-title">Binghamton Circle</text>
      </view>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y style="padding-top: {{safeTop + 88}}px;">
    <view wx:if="{{!profile && loading}}" class="loading">加载中...</view>
    <view wx:if="{{!profile && !loading}}" class="empty-auth">
      <image class="welcome-cover" src="/assets/home/home-logo.jpg" mode="aspectFill" />
      <view class="welcome-title">欢迎加入 Binghamton Circle</view>
      <view class="welcome-desc">
        您可以直接浏览社区公开内容。登录后即可发起活动、参与讨论并享受完整校园服务。新用户请先通过
        <text class="desc-highlight">【邮箱登录】</text>
        完成校园身份认证，注册后可绑定微信实现一键快捷登录。
      </view>

      <view class="login-actions">
        <button class="login-btn wechat-login-btn" bindtap="handleWechatQuickLogin">
          <text class="btn-icon">✿</text>
          <text>微信一键登录</text>
        </button>
        <button class="login-btn email-login-btn" bindtap="handleReLogin">
          <text class="btn-icon">✉</text>
          <text>邮箱登录</text>
        </button>
      </view>

      <view class="agreement-row" bindtap="handleToggleAgreement">
        <view class="agreement-box {{agreedProtocol ? 'checked' : ''}}">
          <text wx:if="{{agreedProtocol}}" class="agreement-check">✓</text>
        </view>
        <view class="agreement-text-wrap">
          <text class="agreement-text">我已阅读并同意</text>
          <text class="agreement-link" bindtap="handleOpenAgreement">服务协议</text>
          <text class="agreement-text">和</text>
          <text class="agreement-link" bindtap="handleOpenPrivacy">隐私政策</text>
        </view>
      </view>
    </view>

    <block wx:if="{{profile}}">
      <view class="hero">
        <view class="hero-bg"></view>
        <view class="hero-main">
          <view class="avatar-wrap">
            <view class="avatar-shell">
              <view class="avatar-ring">
                <image wx:if="{{displayAvatar}}" class="avatar" src="{{displayAvatar}}" mode="aspectFill" />
                <view wx:else class="avatar avatar-fallback">
                  <image class="avatar-default-icon" src="/assets/icons/person-default-muted.svg" mode="aspectFit" />
                </view>
              </view>
            </view>
          </view>
          <view class="name">{{displayName}}</view>
          <view class="bio">{{displayBio}}</view>
          <button class="edit-btn" bindtap="handleToggleEdit">编辑资料</button>
        </view>
      </view>

      <view class="stats-card">
        <view class="stat-item">
          <text class="stat-value">{{postCount}}</text>
          <text class="stat-label">发布</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{activityCount}}</text>
          <text class="stat-label">活动</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{followingCount}}</text>
          <text class="stat-label">关注</text>
        </view>
        <view class="stat-item no-border">
          <text class="stat-value">{{fansCountText}}</text>
          <text class="stat-label">粉丝</text>
        </view>
      </view>

      <view class="menu-section">
        <view class="menu-title">功能菜单</view>
        <view class="menu-group">
          <view class="menu-item" data-action="myposts" bindtap="handleMenuTap">
            <view class="menu-left">
              <view class="menu-icon-wrap"><image class="menu-icon" src="/assets/icons/description-material.svg" mode="aspectFit" /></view>
              <text class="menu-text">我的发布</text>
            </view>
            <image class="menu-arrow" src="/assets/icons/chevron-right-filled.svg" mode="aspectFit" />
          </view>
          <view class="menu-item" data-action="favorites" bindtap="handleMenuTap">
            <view class="menu-left">
              <view class="menu-icon-wrap"><image class="menu-icon" src="/assets/icons/bookmark-material.svg" mode="aspectFit" /></view>
              <text class="menu-text">我的收藏</text>
            </view>
            <image class="menu-arrow" src="/assets/icons/chevron-right-filled.svg" mode="aspectFit" />
          </view>
        </view>

        <view class="menu-group">
          <view class="menu-item">
            <view class="menu-left">
              <view class="menu-icon-wrap"><image class="menu-icon" src="/assets/icons/verified-user-material.svg" mode="aspectFit" /></view>
              <view class="verify-texts">
                <text class="menu-text">学生认证</text>
                <text class="verify-tip">已完成认证</text>
              </view>
            </view>
          </view>
          <view class="menu-item" data-action="settings" bindtap="handleMenuTap">
            <view class="menu-left">
              <view class="menu-icon-wrap"><image class="menu-icon" src="/assets/icons/settings-material.svg" mode="aspectFit" /></view>
              <text class="menu-text">账号与设置</text>
            </view>
            <image class="menu-arrow" src="/assets/icons/chevron-right-filled.svg" mode="aspectFit" />
          </view>
        </view>

        <view wx:if="{{isAdmin}}" class="menu-group">
          <view class="menu-item" data-action="adminBanner" bindtap="handleMenuTap">
            <view class="menu-left">
              <view class="menu-icon-wrap"><image class="menu-icon" src="/assets/icons/notifications-material.svg" mode="aspectFit" /></view>
              <text class="menu-text">首页 Banner 管理</text>
            </view>
            <image class="menu-arrow" src="/assets/icons/chevron-right-filled.svg" mode="aspectFit" />
          </view>
          <view class="menu-item" data-action="adminEmails" bindtap="handleMenuTap">
            <view class="menu-left">
              <view class="menu-icon-wrap"><image class="menu-icon" src="/assets/icons/notifications-primary.svg" mode="aspectFit" /></view>
              <text class="menu-text">登录邮箱白名单</text>
            </view>
            <image class="menu-arrow" src="/assets/icons/chevron-right-filled.svg" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="editor-card" wx:if="{{showEditor}}">
        <view class="editor-title">资料编辑</view>
        <view class="field">
          <view class="label">昵称</view>
          <input value="{{profile.nickname}}" data-field="nickname" bindinput="handleInput" />
        </view>
        <view class="field">
          <view class="label">手机号</view>
          <input value="{{profile.phone}}" data-field="phone" bindinput="handleInput" />
        </view>
        <view class="field">
          <view class="label">学校</view>
          <input value="{{profile.school}}" data-field="school" bindinput="handleInput" />
        </view>
        <view class="field">
          <view class="label">专业</view>
          <input value="{{profile.major}}" data-field="major" bindinput="handleInput" />
        </view>
        <view class="field">
          <view class="label">年级</view>
          <input value="{{profile.grade}}" data-field="grade" bindinput="handleInput" />
        </view>
        <view class="field">
          <view class="label">简介</view>
          <textarea value="{{profile.bio}}" data-field="bio" bindinput="handleInput" />
        </view>
        <button class="save-btn" bindtap="handleSave">保存资料</button>
      </view>

    </block>
  </scroll-view>
</view>

<profile-completion-sheet />

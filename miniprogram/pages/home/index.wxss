.page {
  min-height: 100vh;
  background: #fafaf5;
}

.scroll {
  height: 100vh;
}

.content {
  padding: 0 36rpx;
}

/* 顶部栏 */
.top-bar {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  background: rgba(250, 250, 245, 0.84);
  backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 0 8rpx;
}

.school-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.school-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #0f5f34;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.school-logo-image {
  width: 100%;
  height: 100%;
}

.school-info {
  display: flex;
  flex-direction: column;
  line-height: 1.3;
}

.school-en {
  font-size: 18rpx;
  color: #8a9a8e;
  margin-bottom: 2rpx;
}

.school-name {
  font-size: 28rpx;
  color: #1a2e22;
  font-weight: 600;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.top-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-icon-img {
  width: 40rpx;
  height: 40rpx;
}

/* 主标题 */
.hero-header {
  margin-top: 34rpx;
  margin-bottom: 40rpx;
}

.brand-title {
  font-size: 72rpx;
  line-height: 1.1;
  color: #0f5f34;
  font-weight: 800;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 12rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  color: #6a7a6e;
  line-height: 1.55;
  display: block;
}

/* 搜索栏 */
.search-bar {
  height: 86rpx;
  border-radius: 40rpx;
  background: #e8ebe6;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  margin-bottom: 36rpx;
}

.search-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #8a968e;
}

/* Banner卡片 */
.banner-card {
  background: linear-gradient(145deg, #0f5f34, #1a7a4a);
  border-radius: 32rpx;
  padding: 32rpx 36rpx 34rpx;
  color: #ffffff;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 30rpx rgba(15, 95, 52, 0.14);
}

.banner-tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  display: block;
  margin-bottom: 16rpx;
}

.banner-title {
  font-size: 40rpx;
  line-height: 1.45;
  font-weight: 700;
  display: block;
  margin-bottom: 28rpx;
}

.banner-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.banner-link-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.banner-link-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* 快捷菜单 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 52rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.quick-item:active .quick-icon-wrap {
  transform: scale(0.95);
}

.quick-icon-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.quick-icon-image {
  width: 48rpx;
  height: 48rpx;
}

.quick-label {
  font-size: 22rpx;
  color: #4a5a50;
  line-height: 1.4;
}

/* 最新动态标题 */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 48rpx;
  color: #1a2e22;
  font-weight: 800;
  line-height: 1.2;
}

.section-action {
  font-size: 24rpx;
  color: #0f5f34;
  font-weight: 600;
}

/* 动态卡片 */
.feed-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid #edf1ec;
  box-shadow: 0 8rpx 24rpx rgba(12, 30, 20, 0.06);
}

.feed-loading,
.feed-empty {
  padding: 56rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6a7a6e;
  font-size: 26rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.feed-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.user-mini {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.avatar-mini {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e8ebe6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-mini.green {
  background: #d4e8dc;
}

.avatar-mini.gray {
  background: #e8ebe6;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-anon-icon {
  width: 32rpx;
  height: 32rpx;
}

.avatar-fallback {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f5f34;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-mini-name {
  font-size: 26rpx;
  color: #1a2e22;
  font-weight: 600;
}

.user-mini-meta {
  font-size: 20rpx;
  color: #8a9a8e;
}

.card-tag {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 22rpx;
  letter-spacing: 0.6rpx;
}

.feed-tag-goods {
  background: #a8e6b8;
  color: #1a6d3a;
}

.feed-tag-treehole {
  background: #d9efe2;
  color: #236247;
}

.feed-tag-activity {
  background: #6bc88a;
  color: #ffffff;
}

.feed-title {
  font-size: 32rpx;
  color: #1a2e22;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.feed-content {
  font-size: 26rpx;
  line-height: 1.72;
  color: #2a3a32;
  display: block;
}

.feed-images {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.feed-images-single .feed-image {
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
}

.feed-images-multi {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.feed-images-multi .feed-image {
  width: 100%;
  height: 184rpx;
  border-radius: 16rpx;
  background: #e8ebe6;
}

.feed-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.like-icon-image {
  width: 28rpx;
  height: 28rpx;
}

.stat-icon-image {
  width: 28rpx;
  height: 28rpx;
}

.stat-num {
  font-size: 22rpx;
  color: #5a6a60;
}

.safe-bottom {
  height: 220rpx;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #0f5f34;
  box-shadow: 0 8rpx 24rpx rgba(15, 95, 52, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab-icon {
  width: 44rpx;
  height: 44rpx;
}

.page {
  min-height: 100vh;
  background: #fafaf5;
  color: #1a1c19;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 40;
  background: rgba(250, 250, 245, 0.84);
  backdrop-filter: blur(16rpx);
}

.top-inner {
  height: 64px;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
}

.left-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: #3f4940;
}

.scroll {
  height: 100vh;
}

.container {
  padding-right: 40rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  padding-left: 40rpx;
}

.section-label,
.row-desc,
.suffix {
  letter-spacing: 0;
}

.section-label {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #6f7a6f;
  opacity: 0.7;
  margin: 20rpx 4rpx 12rpx;
}

.wechat-bar {
  margin-bottom: 14rpx;
}

.wechat-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background: #0f7a3f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.wechat-btn::after {
  border: none;
}

.bind-tip {
  margin: 0 4rpx 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #ecf7ef;
  color: #195f35;
  font-size: 22rpx;
  line-height: 1.6;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.row {
  min-height: 98rpx;
  border-radius: 20rpx;
  background: #ffffff;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-column {
  align-items: flex-start;
  flex-direction: column;
  gap: 12rpx;
}

.row-title {
  font-size: 28rpx;
  color: #1a1c19;
  font-weight: 600;
}

.row-desc {
  font-size: 22rpx;
  color: #6f7a6f;
  line-height: 1.6;
}

.mode-tabs {
  width: 100%;
  display: flex;
  gap: 12rpx;
}

.mode-tab {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: #eef2ed;
  color: #4f5d52;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.mode-tab.active {
  background: #0f5f34;
  color: #fff;
}

.email-input-wrap {
  position: relative;
  width: 100%;
}

.input {
  width: 100%;
  min-height: 88rpx;
  border-radius: 16rpx;
  border: none;
  background: #f4f4ef;
  font-size: 24rpx;
  color: #1a1c19;
  padding: 0 22rpx;
  box-sizing: border-box;
}

.email-input {
  padding-right: 230rpx;
}

.suffix {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #6f7a6f;
}

.code-row {
  width: 100%;
  display: flex;
  gap: 12rpx;
}

.code-input {
  flex: 1;
}

.send-btn {
  width: 190rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  border: none;
  background: #d9e5dc;
  color: #234a35;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0;
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  opacity: 0.65;
}

.bottom-bar {
  margin-top: 28rpx;
  padding: 0 0 calc(env(safe-area-inset-bottom) + 12rpx);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  background: #004b24;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.save-btn::after {
  border: none;
}

.page {
  min-height: 100vh;
  background: #f6f8fb;
}

.container {
  padding: 48rpx 40rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.08);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: #1f2933;
}

.desc {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #1f2933;
  margin-bottom: 12rpx;
}

input {
  width: 100%;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  border: none;
}

.code-field {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 12rpx;
}

button {
  border-radius: 999rpx;
}

/* pages/posts/detail/index.wxss */

.page {
  min-height: 100vh;
  background: #fafaf5;
  color: #1a1c19;
}

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  height: 112rpx;
  padding: env(safe-area-inset-top) 24rpx 0;
  background: rgba(250, 250, 245, 0.84);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topbar-left,
.topbar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.topbar-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #004b24;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.back-icon {
  transform: rotate(180deg);
}

.scroll {
  height: 100vh;
  padding-top: calc(env(safe-area-inset-top) + 112rpx);
  padding-bottom: 180rpx;
}

.hero {
  position: relative;
  width: 100%;
  height: 620rpx;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-fallback {
  background: linear-gradient(145deg, #0f6d39, #006633, #84d999);
}

.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(to top, rgba(0, 75, 36, 0.85), rgba(0, 75, 36, 0.12) 58%, rgba(0, 75, 36, 0));
}

.hero-content {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 36rpx;
}

.hero-main {
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
}

.logo-box {
  width: 124rpx;
  height: 124rpx;
  border-radius: 28rpx;
  background: #ffffff;
  padding: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.16);
}

.logo {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #006633;
}

.hero-text {
  flex: 1;
  padding-bottom: 8rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.2;
}

.hero-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.dot {
  margin: 0 10rpx;
}

.join-btn {
  margin-top: 20rpx;
  width: 220rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #004b24;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabs {
  height: 92rpx;
  padding: 0 32rpx;
  background: rgba(250, 250, 245, 0.92);
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: flex-end;
  gap: 40rpx;
}

.tab {
  position: relative;
  height: 92rpx;
  line-height: 92rpx;
  color: #3f4940;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.tab.active {
  color: #004b24;
  font-weight: 800;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: #004b24;
  border-radius: 8rpx 8rpx 0 0;
}

.content-wrap {
  padding: 24rpx 32rpx 0;
}

.post-card {
  border-radius: 30rpx;
  background: #ffffff;
  padding: 30rpx;
  box-shadow: 0 -8rpx 24rpx rgba(26, 28, 25, 0.06);
}

.author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.author-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #006633;
  background: #cbe7f5;
}

.author-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.author-name {
  font-size: 28rpx;
  color: #1a1c19;
  font-weight: 700;
}

.author-time {
  font-size: 22rpx;
  color: #6f7a6f;
}

.post-tag {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #ffd9dc;
  color: #400010;
  font-size: 18rpx;
  font-weight: 700;
}

.post-title {
  font-size: 36rpx;
  line-height: 1.34;
  color: #1a1c19;
  font-weight: 800;
}

.post-content {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: #3f4940;
  white-space: pre-line;
}

.post-images {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.post-image {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
}

.post-actions {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e3e3de;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #3f4940;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.bookmark {
  margin-left: auto;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 36rpx);
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #006633;
  box-shadow: 0 16rpx 30rpx rgba(0, 75, 36, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 60;
}

.fab-icon {
  width: 52rpx;
  height: 52rpx;
}

.loading,
.empty {
  padding: 200rpx 0;
  text-align: center;
  color: #6b7280;
  font-size: 28rpx;
}

.error-card {
  margin: 140rpx 32rpx 0;
  background: #fff5f5;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
}

.error-text {
  color: #d14343;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  display: block;
}

.retry-btn {
  width: 200rpx;
  margin: 0 auto;
}

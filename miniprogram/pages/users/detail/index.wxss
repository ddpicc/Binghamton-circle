/* pages/users/detail/index.wxss */

.page {
  min-height: 100vh;
  background: #f6f8fb;
}

.scroll {
  height: calc(100vh - 80rpx);
  padding-top: 80rpx;
}

.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
}

.profile {
  display: flex;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  background: #e6f4ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #006633;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2933;
}

.meta {
  font-size: 26rpx;
  color: #6b7280;
}

.bio {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

.message-btn {
  margin-top: 32rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
}

.badge {
  position: absolute;
  top: 16rpx;
  right: 120rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #ff4d4f;
}

.loading,
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #6b7280;
  font-size: 28rpx;
}

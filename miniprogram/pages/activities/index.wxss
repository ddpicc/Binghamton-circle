.page {
  min-height: 100vh;
  background: #fafaf5;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 40;
  background: rgba(250, 250, 245, 0.84);
  backdrop-filter: blur(16rpx);
}

.top-inner {
  height: 72rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.top-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e8e8e3;
}

.top-title {
  font-size: 34rpx;
  line-height: 1.1;
  color: #004b24;
  font-weight: 700;
  letter-spacing: 0;
}

.action-pill {
  height: 52rpx;
  border-radius: 999rpx;
  padding: 0 12rpx;
  background: #f0f0ec;
  border: 1rpx solid #e6e9e4;
  display: flex;
  align-items: center;
}

.top-icon {
  width: 30rpx;
  height: 30rpx;
}

.pill-divider {
  width: 1rpx;
  height: 24rpx;
  background: #d6ddd5;
  margin: 0 8rpx;
}

.scroll {
  height: 100vh;
}

.container {
  padding: 0 32rpx;
  box-sizing: border-box;
}

.hero {
  position: relative;
  width: 100%;
  height: 340rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-top: 14rpx;
}

.hero-cover {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.06) 18%, rgba(0, 75, 36, 0.78) 100%);
}

.hero-content {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 102, 51, 0.34);
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.hero-subtitle {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.date-header {
  margin-top: 32rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.date-title {
  font-size: 32rpx;
  color: #1a1c19;
  font-weight: 700;
}

.date-sub {
  font-size: 22rpx;
  color: #004b24;
  font-weight: 600;
}

.date-scroll {
  margin: 0 -40rpx;
  padding: 0 40rpx;
}

.date-list {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 4rpx;
}

.date-item {
  width: 98rpx;
  height: 138rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(26, 28, 25, 0.04);
}

.date-item-active {
  background: #004b24;
  box-shadow: 0 12rpx 26rpx rgba(0, 75, 36, 0.2);
}

.date-week {
  font-size: 16rpx;
  color: #6f7a6f;
  letter-spacing: 1.6rpx;
  font-weight: 700;
}

.date-day {
  margin-top: 8rpx;
  font-size: 40rpx;
  color: #3f4940;
  font-weight: 700;
}

.date-item-active .date-week,
.date-item-active .date-day {
  color: #ffffff;
}

.section-head {
  margin-top: 34rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  color: #1a1c19;
  font-weight: 700;
}

.events-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(26, 28, 25, 0.04);
}

.event-cover-wrap {
  width: 100%;
  height: 0;
  padding-top: 100%;
  border-radius: 34rpx;
  overflow: hidden;
  position: relative;
}

.event-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.event-state {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  background: rgba(0, 102, 51, 0.86);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.event-main {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-top: 14rpx;
}

.event-title {
  display: block;
  color: #1a1c19;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.32;
  margin-bottom: 12rpx;
}

.event-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.meta-icon {
  width: 26rpx;
  height: 26rpx;
}

.meta-text {
  flex: 1;
  color: #6f7a6f;
  font-size: 22rpx;
  line-height: 1.3;
}

.event-bottom {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.people-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 10rpx;
  padding-bottom: 4rpx;
}

.avatar-stack {
  display: flex;
  align-items: center;
}

.mini-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: -12rpx;
  border: 2rpx solid #ffffff;
  background: #d7ded6;
}

.mini-extra {
  margin-right: 0;
  background: #e8e8e3;
  color: #3f4940;
  font-size: 16rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.joined-text {
  color: #6f7a6f;
  font-size: 18rpx;
  font-weight: 600;
  margin-left: 8rpx;
  white-space: nowrap;
}

.join-btn {
  height: 60rpx;
  min-width: 132rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #004b24;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 60rpx;
  margin: 0 0 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
}

.join-btn-joined {
  background: #e8f5e8;
  color: #006633;
}

.join-btn::after {
  border: none;
}

.loading-wrap {
  padding: 120rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: #6f7a6f;
}

.empty-wrap {
  margin-top: 20rpx;
}

.safe-bottom {
  height: 260rpx;
}

.fab-wrap {
  position: fixed;
  right: 30rpx;
  bottom: 182rpx;
  z-index: 45;
}

.fab {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #004b24;
  box-shadow: 0 10rpx 24rpx rgba(0, 75, 36, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-icon {
  width: 42rpx;
  height: 42rpx;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 14rpx 18rpx calc(env(safe-area-inset-bottom) + 8rpx);
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid #f0f1ed;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.nav-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.nav-item-active {
  background: #e8e8e3;
  border-radius: 18rpx;
  padding: 6rpx 0;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-label {
  font-size: 18rpx;
  color: #8a9a8e;
  line-height: 1.2;
}

.nav-label-active {
  color: #0f5f34;
  font-weight: 700;
}

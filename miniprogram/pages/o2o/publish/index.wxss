.page {
  min-height: 100vh;
  background: #fafaf5;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 40;
  background: rgba(250, 250, 245, 0.84);
  backdrop-filter: blur(16rpx);
}

.top-inner {
  height: 64px;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.left-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.close-btn,
.help-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: #3f4940;
}

.top-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #004b24;
  letter-spacing: -0.8rpx;
}

.scroll {
  height: 100vh;
}

.container {
  padding: 0 40rpx;
}

.photo-grid {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-cell {
  height: 206rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

.add-cell {
  background: #e8e8e3;
  border: 2rpx dashed rgba(111, 122, 111, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  width: 52rpx;
  height: 52rpx;
}

.add-text {
  font-size: 18rpx;
  color: #3f4940;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.photo-empty {
  background: #f4f4ef;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-placeholder {
  font-size: 22rpx;
  color: #b0b8af;
}

.photo-filled .photo {
  width: 100%;
  height: 100%;
}

.remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-tip {
  margin-top: 14rpx;
  margin-bottom: 24rpx;
  padding-left: 4rpx;
  font-size: 20rpx;
  color: rgba(63, 73, 64, 0.66);
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 28, 25, 0.04);
  margin-bottom: 20rpx;
}

.title-input {
  width: 100%;
  font-size: 34rpx;
  color: #1a1c19;
  font-weight: 700;
}

.desc-card {
  min-height: 300rpx;
}

.desc-input {
  width: 100%;
  min-height: 188rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1a1c19;
}

.tag-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(111, 122, 111, 0.12);
  display: flex;
  gap: 12rpx;
}

.tag-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f4ef;
  color: #004b24;
  font-size: 20rpx;
  font-weight: 600;
}

.row-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.row-card {
  margin-bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.row-icon {
  width: 36rpx;
  height: 36rpx;
}

.row-title {
  font-size: 30rpx;
  color: #1a1c19;
  font-weight: 700;
}

.price-wrap {
  display: flex;
  align-items: center;
}

.price-symbol {
  font-size: 36rpx;
  color: #004b24;
  font-weight: 700;
  margin-right: 6rpx;
}

.price-input {
  width: 170rpx;
  text-align: right;
  font-size: 34rpx;
  color: #1a1c19;
  font-weight: 800;
}

.picker-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.picker-text {
  max-width: 200rpx;
  font-size: 24rpx;
  color: #3f4940;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-icon {
  width: 26rpx;
  height: 26rpx;
}

.method-head {
  margin-bottom: 18rpx;
}

.method-row {
  display: flex;
  gap: 14rpx;
}

.method-chip {
  flex: 1;
  border-radius: 22rpx;
  padding: 18rpx 16rpx;
  background: #f4f4ef;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.method-chip-active {
  background: #cbe7f5;
  border: 2rpx solid rgba(0, 75, 36, 0.12);
}

.method-label {
  font-size: 24rpx;
  color: #304a55;
  font-weight: 600;
}

.method-icon {
  width: 26rpx;
  height: 26rpx;
}

.method-check {
  font-size: 22rpx;
  color: #004b24;
  font-weight: 700;
}

.rental-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.rental-field {
  border-radius: 20rpx;
  background: #f7f7f2;
  padding: 18rpx 20rpx;
  min-width: 0;
}

.rental-full {
  grid-column: 1 / -1;
}

.rental-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #6f7a6f;
  font-weight: 700;
}

.rental-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rental-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rental-price-wrap {
  justify-content: flex-end;
}

.rental-input {
  width: 100%;
  font-size: 28rpx;
  color: #1a1c19;
  font-weight: 700;
}

.rental-input.full {
  width: 100%;
}

.rental-unit {
  font-size: 24rpx;
  color: #6f7a6f;
  font-weight: 700;
}

.facility-section {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(111, 122, 111, 0.12);
}

.facility-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.facility-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f4f4ef;
  color: #3f4940;
  font-size: 22rpx;
  font-weight: 600;
}

.facility-chip-active {
  background: #d9efe2;
  color: #004b24;
}

.extra-card {
  padding-top: 0;
  padding-bottom: 0;
}

.extra-input {
  width: 100%;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #1a1c19;
}

.divider {
  height: 2rpx;
  background: rgba(111, 122, 111, 0.12);
}

.safety-card {
  border-left: 8rpx solid #004b24;
  background: rgba(0, 75, 36, 0.06);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.safety-icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
}

.safety-title {
  font-size: 26rpx;
  color: #004b24;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.safety-text {
  font-size: 22rpx;
  color: #3f4940;
  line-height: 1.5;
}

.safe-bottom {
  height: 210rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 18rpx 40rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(250, 250, 245, 0.92);
  backdrop-filter: blur(14rpx);
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #004b24;
}

.agreement-text {
  font-size: 18rpx;
  color: #6f7a6f;
  letter-spacing: 1.2rpx;
  font-weight: 700;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 22rpx;
  background: #004b24;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 75, 36, 0.22);
}

.submit-btn::after {
  border: none;
}

.submit-icon {
  width: 28rpx;
  height: 28rpx;
}

.placeholder {
  color: #a7b0a7;
}

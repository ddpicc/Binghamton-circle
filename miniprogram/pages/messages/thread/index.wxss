/* pages/messages/thread/index.wxss */

.page {
  min-height: 100vh;
  background: #f6f8fb;
  display: flex;
  flex-direction: column;
}

.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 80rpx;
}

.messages-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.load-more {
  text-align: center;
  color: #666;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.empty {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #888;
  font-size: 26rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 60rpx;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-end;
}

.message-item.self {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #006633;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.message-item.self .bubble {
  background: #006633;
  color: #ffffff;
}

.content {
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.timestamp {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
}

.message-item.self .timestamp {
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  background: #ffffff;
  border-top: 1px solid #eef2f7;
}

.message-input {
  flex: 1;
  background: #f4f6f9;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.send-button {
  width: 140rpx;
}

.error {
  position: fixed;
  bottom: 140rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.error-text {
  color: #ff4d4f;
  font-size: 24rpx;
}

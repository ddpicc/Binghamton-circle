.page {
  min-height: 100vh;
  background: #f6f8fb;
}

.scroll {
  height: calc(100vh - 80rpx);
}

.container {
  padding: 32rpx 36rpx 80rpx;
}

.badge {
  display: inline-flex;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 102, 51, 0.12);
  color: #006633;
  font-size: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 24rpx 0 12rpx;
  color: #1f2933;
}

.meta {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}

.content {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  line-height: 1.7;
  color: #1f2933;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.05);
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: #6b7280;
}

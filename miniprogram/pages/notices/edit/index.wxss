.page {
  min-height: 100vh;
  background: #f6f8fb;
}

.scroll {
  height: calc(100vh - 80rpx);
}

.container {
  padding: 32rpx 36rpx 80rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.form-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.05);
}

.form-item.switch {
  flex-direction: row;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1f2933;
}

input,
textarea,
.picker {
  width: 100%;
  font-size: 26rpx;
  color: #1f2933;
}

.textarea {
  min-height: 240rpx;
  border: none;
}

button {
  border-radius: 999rpx;
}

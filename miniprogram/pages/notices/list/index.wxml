<view class="page">
  <view class="top-bar" style="padding-top: {{safeTop}}px;">
    <view class="top-inner">
      <view class="left-wrap">
        <text class="close-btn" bindtap="handleBack">×</text>
        <text class="top-title">提醒</text>
      </view>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view class="container" style="padding-top: {{safeTop + 64}}px;">
    <view wx:if="{{list.length}}">
      <view wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" class="notice-card" bindtap="handleOpen">
        <view class="notice-header">
          <text class="badge">{{item.category || '通知'}} </text>
          <text class="time">{{item.displayTime}}</text>
        </view>
        <view class="title">{{item.title}}</view>
        <view class="excerpt">{{item.content}}</view>
        <view wx:if="{{isAdmin}}" class="admin-actions">
          <button size="mini" type="warn" data-id="{{item.id}}" catchtap="handleDelete">删除</button>
        </view>
      </view>
    </view>

      <empty-state wx:else title="暂无提醒" description="稍后再来看看" />

      <button wx:if="{{isAdmin}}" class="create-btn" type="primary" bindtap="handleCreate">发布通知</button>
    </view>
  </scroll-view>
</view>

<profile-completion-sheet />
